      "name": "get_shipment_rates",
      "notes": "",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "rates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "currency_code": {
                  "enum": [
                    "USD"
                  ],
                  "type": "string"
                },
                "estimated_delivery_date": {
                  "maxLength": 10,
                  "minLength": 10,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "type": "string"
                },
                "service_code": {
                  "enum": [
                    "01",
                    "02",
                    "03",
                    "07",
                    "08",
                    "11",
                    "12",
                    "13",
                    "14",
                    "54",
                    "59",
                    "65"
                  ],
                  "type": "string"
                },
                "service_name": {
                  "enum": [
                    "UPS Next Day Air",
                    "UPS 2nd Day Air",
                    "UPS Ground",
                    "UPS Worldwide Express",
                    "UPS Worldwide Expedited",
                    "UPS Standard",
                    "UPS 3 Day Select",
                    "UPS Next Day Air Saver",
                    "UPS Next Day Air Early",
                    "UPS Worldwide Express Plus",
                    "UPS 2nd Day Air A.M.",
                    "UPS Worldwide Saver"
                  ],
                  "type": "string"
                },
                "total_charge": {
                  "maxLength": 13,
                  "minLength": 4,
                  "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
                  "type": "string"
                }
              },
              "required": [
                "service_code",
                "service_name",
                "total_charge",
                "currency_code"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "type": "array"
          },
          "selected": {
            "enum": [
              "01",
              "02",
              "03",
              "07",
              "08",
              "11",
              "12",
              "13",
              "14",
              "54",
              "59",
              "65"
            ],
            "type": "string"
          }
        },
        "required": [
          "rates",
          "selected"
        ],
        "type": "object"
      },
