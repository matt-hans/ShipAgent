  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Validate a destination and return canonical address guidance.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input_reference": {
          "description": "Opaque ShipAgent shipment input reference.",
          "maxLength": 41,
