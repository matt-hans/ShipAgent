        "input_reference"
      ],
      "type": "object"
    },
    "name": "validate_shipment_address",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "guidance_codes": {
          "description": "Bounded redacted remediation categories.",
          "items": {
            "enum": [
              "no_action_required",
              "postal_code_review_required",
              "locality_review_required",
              "region_review_required",
              "recipient_review_required",
              "destination_not_recognized",
              "multiple_candidates",
              "carrier_validation_unavailable"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "valid": {
          "type": "boolean"
        },
        "validation_artifact_id": {
          "description": "Opaque ShipAgent validation artifact reference.",
          "maxLength": 46,
          "minLength": 46,
          "pattern": "^sa_validation_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "validation_artifact_id",
        "valid",
        "guidance_codes"
      ],
      "type": "object"
    },
