[
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Return operational status for the active account and device.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "description": "Opaque ShipAgent correlation identifier.",
          "maxLength": 47,
          "minLength": 47,
          "pattern": "^sa_correlation_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "correlation_id"
      ],
      "type": "object"
    },
    "name": "get_shipagent_status",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "active_device_id": {
          "description": "Opaque ShipAgent execution device identifier.",
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^sa_device_[0-9a-f]{32}$",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "enum": [
              "shipment_ingress",
              "address_validation",
              "rate_shopping",
              "shipment_preview",
              "shipment_execution",
              "job_status",
              "label_handoff"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "active_device_id",
        "capabilities"
      ],
      "type": "object"
    },
    "title": "Get shipagent status"
  },
