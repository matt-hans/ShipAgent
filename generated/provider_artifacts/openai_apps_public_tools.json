  {
    "_meta": {
      "ui": {
        "resourceUri": "ui://shipagent/rates.html"
      }
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Generate rate options for a validated shipment request.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input_reference": {
          "description": "Opaque ShipAgent shipment input reference.",
          "maxLength": 41,
          "minLength": 41,
          "pattern": "^sa_input_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "input_reference"
      ],
      "type": "object"
    },
    "name": "get_shipment_rates",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "rates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "currency_code": {
                "enum": [
                  "USD"
                ],
                "type": "string"
              },
              "estimated_delivery_date": {
                "maxLength": 10,
                "minLength": 10,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "service_code": {
                "enum": [
                  "01",
                  "02",
                  "03",
                  "07",
                  "08",
                  "11",
                  "12",
                  "13",
                  "14",
                  "54",
                  "59",
                  "65"
                ],
                "type": "string"
              },
              "service_name": {
                "enum": [
                  "UPS Next Day Air",
                  "UPS 2nd Day Air",
                  "UPS Ground",
                  "UPS Worldwide Express",
                  "UPS Worldwide Expedited",
                  "UPS Standard",
                  "UPS 3 Day Select",
                  "UPS Next Day Air Saver",
                  "UPS Next Day Air Early",
                  "UPS Worldwide Express Plus",
                  "UPS 2nd Day Air A.M.",
                  "UPS Worldwide Saver"
                ],
                "type": "string"
              },
              "total_charge": {
                "maxLength": 13,
                "minLength": 4,
                "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
                "type": "string"
              }
            },
            "required": [
              "service_code",
              "service_name",
              "total_charge",
              "currency_code"
            ],
            "type": "object"
          },
          "maxItems": 12,
          "type": "array"
        },
        "selected": {
          "enum": [
            "01",
            "02",
            "03",
            "07",
            "08",
            "11",
            "12",
            "13",
            "14",
            "54",
            "59",
            "65"
          ],
          "type": "string"
        }
      },
      "required": [
        "rates",
        "selected"
      ],
      "type": "object"
    },
    "title": "Get shipment rates"
  },
