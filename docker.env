# Docker-only listener/authentication override.
#
# `.env` keeps fake_local for loopback desktop/local development. Compose loads
# this file after `.env` so a container that must listen on 0.0.0.0 never uses
# fake_local. API routes are additionally protected by the required
# SHIPAGENT_API_KEY supplied from `.env`.
SHIPAGENT_AUTH_MODE=auth0
SHIPAGENT_BIND_HOST=0.0.0.0
