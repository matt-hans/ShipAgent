# PLACEHOLDERS ONLY. Load actual approved values through the operator environment.
# This config starts only the existing status-only control plane, not a target.
SHIPAGENT_AUTH_MODE=auth0
SHIPAGENT_ENVIRONMENT=prototype
SHIPAGENT_BIND_HOST=127.0.0.1
SHIPAGENT_PUBLIC_BASE_URL=https://mcp-host.example.invalid
SHIPAGENT_AUTH0_AUDIENCE=https://mcp-host.example.invalid/mcp
SHIPAGENT_AUTH0_ISSUER=https://issuer.example.invalid/
SHIPAGENT_AUTH0_PROVIDER_CLIENTS={"REPLACE_CHATGPT_CLIENT_ID":"chatgpt","REPLACE_CLAUDE_CLIENT_ID":"claude_ai","REPLACE_OPERATOR_CLIENT_ID":"operator"}
# Supply separately; never commit actual database/Redis credentials or secrets.
# SHIPAGENT_DATABASE_URL=<operator-provisioned-control-plane-database-url>
# SHIPAGENT_REDIS_URL=<operator-provisioned-redis-url>
